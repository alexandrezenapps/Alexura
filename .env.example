# ==============================================================================
# Alexura AI Lyrics Sync Engine — Environment Variables Template
# Copy to `.env` for local development. NEVER commit real API keys.
# ==============================================================================

# --- Backend Server Secrets (NEVER expose with VITE_ prefix) ---
# GEMINI_API_KEY: Server-side Gemini API key (used only by backend routes/adapters).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Server-side Google Maps Platform API key.
GOOGLE_MAPS_API_KEY=""

# Optional specialized Phase 2 external AI model endpoints (server-side HTTPS URLs).
# Leave blank in Phase 1 to run honest unconfigured / stub adapters.
VOCAL_SEPARATION_ENDPOINT=""
SINGING_ASR_ENDPOINT=""
FORCED_ALIGNMENT_ENDPOINT=""

# --- Backend Runtime & Storage Configuration ---
APP_PORT=3000
FASTAPI_PORT=8000
ALEXURA_DATA_DIR=".alexura_data/phase1"
ALEXURA_LOG_LEVEL="INFO"
MAX_UPLOAD_MB=100

# --- Frontend Safe Public Configuration (no secrets allowed here) ---
# Optional custom base URL when launching standalone Vite frontend against FastAPI (:8000)
VITE_API_BASE_URL=""

# --- Optional Deployment & Hosting Bridges ---
APP_URL="MY_APP_URL"
EXTERNAL_APP_URL=""
VERCEL_DEPLOY_HOOK_URL=""
