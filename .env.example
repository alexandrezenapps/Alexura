# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EXTERNAL_APP_URL: URL of your deployed Vercel app (e.g., https://alexura.vercel.app)
# used by /api/bridge to ping or push songs, lyrics, and synced data.
EXTERNAL_APP_URL=""

# VERCEL_DEPLOY_HOOK_URL: Vercel Deploy Hook URL (https://api.vercel.com/v1/integrations/deploy/...)
# triggered from the Firebase & Vercel Studio panel or via /api/bridge.
VERCEL_DEPLOY_HOOK_URL=""

# GOOGLE_MAPS_API_KEY: Server-side Google Maps Platform API key for Weather,
# Air Quality, Pollen, and Geocoding endpoints.
GOOGLE_MAPS_API_KEY=""

