# Backend environment template (copy to backend/.env for local runs; never commit real secrets)
GEMINI_API_KEY=
SINGING_ASR_ENDPOINT=
VOCAL_SEPARATION_ENDPOINT=
FORCED_ALIGNMENT_ENDPOINT=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
ALEXURA_DATA_DIR=storage
ALEXURA_LOG_LEVEL=INFO
MAX_UPLOAD_MB=100
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
