{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexura.studio/schemas/segment_mapping.schema.json",
  "title": "AnalysisSegmentMapping",
  "description": "Maps timestamps produced inside a sliced/trimmed analysis segment back onto the untouched original audio timeline (seconds >= 0.0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_segment_id",
    "analysis_start",
    "analysis_end",
    "original_start",
    "original_end"
  ],
  "properties": {
    "analysis_segment_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_start": {
      "type": "number",
      "minimum": 0
    },
    "analysis_end": {
      "type": "number",
      "minimum": 0
    },
    "original_start": {
      "type": "number",
      "minimum": 0
    },
    "original_end": {
      "type": "number",
      "minimum": 0
    }
  }
}
